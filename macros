; ============================================================================
; helper.asm
; Modulo auxiliar vinculado ao main.asm
; NASM x86-64
; ============================================================================

global helper_add

section .text

; ----------------------------------------------------------------------------
; helper_add
; Soma dois inteiros de 64 bits.
;
; Linux / System V AMD64:
;   arg1 = RDI
;   arg2 = RSI
;
; Windows x64:
;   arg1 = RCX
;   arg2 = RDX
;
; Retorno:
;   RAX = arg1 + arg2
; ----------------------------------------------------------------------------
helper_add:
%ifdef LINUX
    mov rax, rdi
    add rax, rsi
%elifdef WINDOWS
    mov rax, rcx
    add rax, rdx
%else
    %error "Defina a plataforma com -DLINUX ou -DWINDOWS"
%endif
    ret
